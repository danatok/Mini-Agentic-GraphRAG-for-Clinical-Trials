# AWS
AWS_PROFILE=default
AWS_REGION=us-east-1

# Neptune Database Serverless (filled in after scripts/setup_neptune.py runs)
NEPTUNE_ENDPOINT=
NEPTUNE_PORT=8182

# ClinicalTrials.gov query focus (keep the demo scoped to one condition)
CONDITION=type 2 diabetes
TRIAL_COUNT=25

# Bedrock model IDs
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Claude 3 Haiku is blocked as legacy on this account; Claude Haiku 4.5 requires
# the cross-region inference profile ID (not the bare model ID) for on-demand invoke.
BEDROCK_AGENT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
